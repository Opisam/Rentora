# Local development (copy to .env) — used by `npm run dev`
DB_NAME=rental_platform_dev
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost

JWT_SECRET=generate_a_long_random_string_here
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides (code defaults: 300 global / 10 auth per 15 min)
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=10

# Production hosts instead provide a single connection string:
# DATABASE_URL=postgresql://user:pass@host/db
# DB_SSL=true   # required for external Postgres connections, not Render-internal
